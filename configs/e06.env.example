# Source this file before Python; model/training values match the original defaults.
# Checkpoint selection is fixed to highest validation mean antigen/antibody MCC.
# Paths are deliberately not assigned: set DATA_FILE_PATH, SPLIT_CSV_DIR,
# TEST_DATA_FILE_PATH, RUN_DIR and OUTPUT_BASE_DIR for your own installation.
# The original defaults to CUDA_VISIBLE_DEVICES=7. Choose a visible GPU explicitly.
export RUN_FOLDS=0,1,2,3,4
export EPOCHS=25
export ACCUM_STEPS=8
export LEARN_RATE=5e-5
export WEIGHT_DECAY=1e-4
export SCHEDULER_ETA_MIN=1e-6
export ENABLE_AB_CDR_GATE=1
export ENABLE_FLEX_ATTN_BIAS=1
export ENABLE_FLEX_AUX_LOSS=1
export AB_CDR_GATE_BETA=1.0
export FLEX_AUX_WEIGHT=3.0
export GATE_PREF_WEIGHT=2.0
export GATE_PREF_WARMUP_EPOCHS=5
export FLEX_DRIVE_NEUTRAL_BLEND_ENABLED=1
export FLEX_DRIVE_NEUTRAL_DECAY_EPOCHS=4
export FLEX_DRIVE_NEUTRAL_RATIO_START=0.95
export FLEX_DRIVE_NEUTRAL_RATIO_FINAL=0.05
export ALPHA_ATTR_WEIGHT=0.0
export AG_LOSS_WEIGHT=6.0
export AB_LOSS_WEIGHT=5.0
export EDGE_AGAB_LOSS_WEIGHT=4.0
export EDGE_ABAG_LOSS_WEIGHT=4.0
export EDGE_NEG_RATIO=3.0
export LABEL_SMOOTH_EPS=0.05
export LABEL_SMOOTH_NODE=1
export LABEL_SMOOTH_EDGE=1
export PATCH_MATRIX_ZSCORE=1
export FLEXMEC_MULTIHEADS=16
export USE_LAYER_NORM_CNN=0
export PLOT_EVERY_EPOCHS=5
# RUN_SEED was unset in the original defaults; set it explicitly for reproducibility.

